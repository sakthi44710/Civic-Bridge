[
  {
    "scheme_id": "EDU001",
    "name": "PM Vidyalaxmi - Central Sector Interest Subsidy Scheme",
    "description": "Interest subsidy on education loans for students from economically weaker sections pursuing higher education in recognized institutions.",
    "category": "education",
    "state": "all",
    "ministry": "Ministry of Education",
    "portal_url": "https://www.vidyalakshmi.co.in/",
    "status": "active",
    "benefit_amount": "Full interest subsidy during moratorium period + 1 year",
    "benefit_description": "Full interest subsidy on education loan up to ₹10 lakhs for students with family income below ₹4.5 lakhs per annum",
    "eligibility_criteria": {
      "max_income": 450000,
      "education_level": ["12th_pass", "graduate", "post_graduate"],
      "categories": ["general", "obc", "sc", "st", "ews"]
    },
    "required_documents": [
      {"document_type": "aadhaar", "mandatory": true},
      {"document_type": "income_certificate", "mandatory": true},
      {"document_type": "marksheet", "mandatory": true},
      {"document_type": "admission_letter", "mandatory": true},
      {"document_type": "bank_passbook", "mandatory": true}
    ],
    "how_to_apply": "Register on Vidya Lakshmi Portal → Search for education loans → Fill application → Upload documents → Submit to selected banks",
    "automation_config": {
      "portal": "vidyalakshmi",
      "pages": [
        {
          "name": "Student Registration",
          "url": "https://www.vidyalakshmi.co.in/Students/signup",
          "fields": [
            {"field_name": "studentName", "source": "profile.name", "type": "text"},
            {"field_name": "dob", "source": "profile.dob", "type": "date"},
            {"field_name": "gender", "source": "profile.gender", "type": "select"},
            {"field_name": "mobile", "source": "profile.phone", "type": "text"},
            {"field_name": "email", "source": "profile.email", "type": "email"},
            {"field_name": "aadhaarNo", "source": "aadhaar.number", "type": "text"},
            {"field_name": "state", "source": "profile.state", "type": "select"},
            {"field_name": "pincode", "source": "profile.pincode", "type": "text"}
          ]
        },
        {
          "name": "Course & Institution Details",
          "url": "https://www.vidyalakshmi.co.in/Students/coursedetails",
          "fields": [
            {"field_name": "courseName", "source": "education.course_name", "type": "text"},
            {"field_name": "institutionName", "source": "education.institution", "type": "text"},
            {"field_name": "courseDuration", "source": "education.duration", "type": "text"},
            {"field_name": "annualFee", "source": "education.annual_fee", "type": "text"}
          ]
        },
        {
          "name": "Family & Financial Details",
          "url": "https://www.vidyalakshmi.co.in/Students/familydetails",
          "fields": [
            {"field_name": "fatherName", "source": "profile.father_name", "type": "text"},
            {"field_name": "motherName", "source": "profile.mother_name", "type": "text"},
            {"field_name": "annualIncome", "source": "profile.income", "type": "text"},
            {"field_name": "category", "source": "profile.category", "type": "select"},
            {"field_name": "bankAccount", "source": "profile.bank_account", "type": "text"},
            {"field_name": "ifsc", "source": "profile.ifsc", "type": "text"}
          ]
        }
      ]
    }
  },

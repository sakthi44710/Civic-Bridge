# CivicBridge Backend

# ── AWS Core ─────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_key
AWS_SECRET_ACCESS_KEY=your_secret
ENVIRONMENT=development

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=strong_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ── DynamoDB Tables ───────────────────────────────────────────────────────
USERS_TABLE=civicbridge-users
DOCUMENTS_TABLE=civicbridge-documents
APPLICATIONS_TABLE=civicbridge-applications
SCHEMES_TABLE=civicbridge-schemes
CONVERSATIONS_TABLE=civicbridge-conversations

# ── S3 Buckets ────────────────────────────────────────────────────────────
DOCUMENTS_BUCKET=civicbridge-documents
SCREENSHOTS_BUCKET=civicbridge-screenshots

# ── AI — Mistral Large 3 via Bedrock (voice + all AI tasks) ─────────────
BEDROCK_MODEL_ID=mistral.mistral-large-3-675b-instruct
# Bearer-token API key (alternative to IAM SigV4)
BEDROCK_API_KEY=ABSK...
BEDROCK_API_REGION=ap-south-1
# Fallback model (optional)
# BEDROCK_FALLBACK_MODEL_ID=

# ── Sarvam AI — STT (saarika:v2) + TTS (bulbul:v3, Ishita 8000Hz) ────────
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_...

# ── Live browser (noVNC) ──────────────────────────────────────────────────
DISPLAY=:99
NOVNC_PORT=6080
VNC_PORT=5900

# ── Auth — AWS SNS OTP + Google OAuth via Cognito ─────────────────────────
SNS_SENDER_ID=CivicBridge
# Phone country prefix for OTP SMS (default: +91 for India)
# PHONE_COUNTRY_PREFIX=+91
COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=
COGNITO_DOMAIN=
COGNITO_REGION=ap-south-1

# ── Google OAuth (Direct fallback) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

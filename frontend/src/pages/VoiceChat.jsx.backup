import { useState, useRef, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuthStore, useLanguageStore, useVoiceStore } from '../store';
import { chatAPI, documentsAPI, userAPI, applicationsAPI } from '../services/api';
import useVoiceCall from '../hooks/useVoiceCall';
import Globe from '../components/Globe';
import Background from '../components/Background';
import toast from 'react-hot-toast';

// Make toast available globally for useVoiceCall hook
if (typeof window !== 'undefined') window.toast = toast;

const TAP_TEXT = {
  hi: 'बोलने के लिए टैप करें', en: 'Tap to start',
  ta: 'தொடங்க தட்டவும்', te: 'ప్రారంభించడానికి నొక్కండి',
  bn: 'শুরু করতে ট্যাপ করুন', mr: 'सुरू करण्यासाठी टॅप करा',
  gu: 'શરૂ કરવા માટે ટેપ કરો', kn: 'ಪ್ರಾರಂಭಿಸಲು ಟ್ಯಾಪ್ ಮಾಡಿ',
  ml: 'ആരംഭിക്കാൻ ടാപ്പ് ചെയ്യുക', pa: 'ਸ਼ੁਰੂ ਕਰਨ ਲਈ ਟੈਪ ਕਰੋ',
};

export default function VoiceChat() {
  const navigate = useNavigate();
  const { user, logout } = useAuthStore();
  const { language } = useLanguageStore();
  const { setStatus: setVoiceStoreStatus } = useVoiceStore();
  const chatEndRef = useRef(null);
  const fileRef = useRef(null);

  // ─── State ─────────────────────────────────────────
  const [inCall, setInCall] = useState(false);
  const [status, setStatus] = useState('idle');
  const [micVolume, setMicVolume] = useState(0);
  const [messages, setMessages] = useState([]);
  const [textInput, setTextInput] = useState('');
  const [conversationId, setConversationId] = useState(null);
  const [currentAppName, setCurrentAppName] = useState('New Application');
  const [formInfo, setFormInfo] = useState(null);
  const [profileCompletion, setProfileCompletion] = useState(0);
  const [docCount, setDocCount] = useState(0);
  const [documents, setDocuments] = useState([]);
  const [uploading, setUploading] = useState(false);

  // ─── Voice Call Hook ──────────────────────────────
  const voiceCall = useVoiceCall({
    conversationId,
    language,
    onConversationId: setConversationId,
    onUserMessage: (text) =>
      setMessages((prev) => [...prev, { role: 'user', content: text, timestamp: new Date().toISOString() }]),
    onAIMessage: (text) => {
      setMessages((prev) => [...prev, { role: 'assistant', content: text, timestamp: new Date().toISOString() }]);
    },
    onFormUpdate: (update) => {
      setFormInfo(update);
    },
    onResearchResults: () => {},
    onStatusChange: (s) => { setStatus(s); setVoiceStoreStatus(s); },
    onVolumeChange: setMicVolume,
  });

  // ─── Load profile + docs on mount ─────────────────
  useEffect(() => { loadProfileStatus(); loadDocCount(); fetchDocuments(); }, []);
  useEffect(() => { chatEndRef.current?.scrollIntoView({ behavior: 'smooth' }); }, [messages]);

  const fetchDocuments = async () => {
    try {
      const resp = await documentsAPI.list();
      const docs = resp.data.documents || [];
      docs.sort((a, b) => new Date(b.upload_date || 0) - new Date(a.upload_date || 0));
      setDocuments(docs);
    } catch { /* keep empty */ }
  };

  const handleUpload = async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    if (file.size > 10 * 1024 * 1024) {
      toast.error('File too large. Maximum size is 10MB.');
      return;
    }
    setUploading(true);
    try {
      await documentsAPI.upload(file);
      toast.success('Document uploaded');
      fetchDocuments();
      loadDocCount();
    } catch (err) {
      toast.error(err.response?.data?.detail || 'Upload failed');
    }
    setUploading(false);
    if (fileRef.current) fileRef.current.value = '';
  };

  // ─── Keyboard shortcuts ───────────────────────────
  useEffect(() => {
    const handleKeyPress = (e) => {
      if (e.code === 'Space' && e.target.tagName !== 'INPUT' && e.target.tagName !== 'TEXTAREA') {
        e.preventDefault();
        if (!inCall) { setInCall(true); voiceCall.startCall(); }
        else { setInCall(false); voiceCall.endCall(); }
      }
      if (e.code === 'Escape') {
        if (leftOpen) setLeftOpen(false);
        if (rightOpen) setRightOpen(false);
        if (historyOpen) setHistoryOpen(false);
      }
    };
    window.addEventListener('keydown', handleKeyPress);
    return () => window.removeEventListener('keydown', handleKeyPress);
  }, [inCall, leftOpen, rightOpen, historyOpen]);

  const loadProfileStatus = async () => {
    try {
      const resp = await userAPI.getProfile();
      const p = resp.data;
      const fields = ['name', 'email', 'phone_number', 'dob', 'gender', 'category', 'state', 'district', 'pincode', 'address'];
      setProfileCompletion(Math.round((fields.filter((f) => p[f]).length / fields.length) * 100));
    } catch { setProfileCompletion(0); }
  };

  const loadDocCount = async () => {
    try {
      const resp = await documentsAPI.list();
      const docs = Array.isArray(resp.data) ? resp.data : resp.data?.documents || [];
      setDocCount(docs.length);
    } catch { setDocCount(0); }
  };

  // ─── Globe click: start/end call ──────────────────
  const handleGlobeClick = () => {
    if (!inCall) { setInCall(true); voiceCall.startCall(); }
    else if (status === 'speaking') { voiceCall.skipResponse(); }
  };

  const handleEndCall = () => { setInCall(false); voiceCall.endCall(); };

  // ─── Text Chat ────────────────────────────────────
  const sendTextMessage = async () => {
    const msg = textInput.trim();
    if (!msg) return;
    setTextInput('');
    setShowChat(true);
    setMessages((prev) => [...prev, { role: 'user', content: msg, timestamp: new Date().toISOString() }]);

    try {
      const resp = await chatAPI.sendMessage(msg, conversationId, language);
      const data = resp.data;
      setConversationId(data.conversation_id);
      if (data.message) {
        setMessages((prev) => [...prev, {
          role: 'assistant', content: data.message, timestamp: new Date().toISOString(),
          agents: data.agents_used,
        }]);
        if (data.agents_used) setActiveAgents(data.agents_used);
      }
      if (data.form_update) {
        setFormInfo(data.form_update);
        if (data.form_update.screenshot) setFormScreenshot(`data:image/png;base64,${data.form_update.screenshot}`);
      }
      if (!currentAppName || currentAppName === 'New Application') setCurrentAppName(msg.substring(0, 30));
    } catch {
      setMessages((prev) => [...prev, { role: 'assistant', content: 'Something went wrong. Please try again.', timestamp: new Date().toISOString() }]);
    }
  };

  const handleKeyDown = (e) => { if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendTextMessage(); } };

  // ─── Session Management ───────────────────────────
  const startNewApplication = () => {
    setConversationId(null);
    setMessages([]);
    setCurrentAppName('New Application');
    setFormScreenshot(null);
    setFormInfo(null);
    setActiveAgents([]);
    setHistoryOpen(false);
    setShowChat(false);
    if (inCall) { setInCall(false); voiceCall.endCall(); }
  };

  const loadApplication = async (app) => {
    setHistoryOpen(false);
    if (app.type === 'general_counsel') {
      setConversationId(null);
      setMessages([]);
      setCurrentAppName('General Counsel');
      setFormScreenshot(null);
      setFormInfo(null);
      return;
    }
    setCurrentAppName(app.scheme_name || 'Application');
    try {
      const resp = await applicationsAPI.get(app.application_id);
      const data = resp.data;
      if (data?.conversation_id) setConversationId(data.conversation_id);
    } catch { /* keep current state */ }
  };

  const handleLogout = () => { if (inCall) voiceCall.endCall(); logout(); navigate('/auth', { replace: true }); };
  const tapText = TAP_TEXT[language] || TAP_TEXT['en'];

  const phases = [
    { name: 'Discovery', icon: '🔍', done: messages.length > 0 },
    { name: 'Documents', icon: '📄', done: docCount > 0 },
    { name: 'Form Fill', icon: '📝', done: !!formInfo },
    { name: 'Submit', icon: '🚀', done: false },
  ];

  return (
    <div className="fixed inset-0 bg-[#050508] flex flex-col overflow-hidden">
      <Background />

      {/* ═══════════════════════════════════════════════════════════
           FLOATING DOCK — Bottom anchored macOS-style navigation
         ═══════════════════════════════════════════════════════════ */}
      <div className="fixed bottom-0 left-0 right-0 z-40 flex justify-center pb-3 px-4 pointer-events-none">
        <div className="pointer-events-auto flex items-center gap-1 px-2 py-1.5 rounded-2xl bg-[#0a0a12]/90 backdrop-blur-2xl border border-white/[0.04] shadow-2xl shadow-black/60">
          {/* Menu */}
          <button onClick={() => setLeftOpen(true)} className="dock-btn group" title="Menu">
            <svg className="w-[18px] h-[18px] text-[#666] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <span className="dock-label">Menu</span>
          </button>

          {/* Applications */}
          <button onClick={() => setHistoryOpen(true)} className="dock-btn group" title="Applications">
            <svg className="w-[18px] h-[18px] text-[#666] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            <span className="dock-label">Apps</span>
          </button>

          {/* New Chat */}
          <button onClick={startNewApplication} className="dock-btn dock-btn-primary group" title="New Chat">
            <svg className="w-[20px] h-[20px] text-black" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={2}>
              <path strokeLinecap="round" strokeLinejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>

          {/* Documents */}
          <button onClick={() => setRightOpen(true)} className="dock-btn group relative" title="Documents">
            <svg className="w-[18px] h-[18px] text-[#666] group-hover:text-white transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={1.5} d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8" />
            </svg>
            <span className="dock-label">Docs</span>
            {docCount > 0 && (
              <span className="absolute -top-0.5 -right-0.5 w-3.5 h-3.5 rounded-full bg-[#00cc88] text-[7px] text-black font-bold flex items-center justify-center">{docCount}</span>
            )}
          </button>

          {/* Profile */}
          <button onClick={() => navigate('/profile')} className="dock-btn group" title="Profile">
            <div className="relative w-5 h-5">
              <svg className="w-5 h-5 -rotate-90" viewBox="0 0 36 36">
                <circle cx="18" cy="18" r="14" fill="none" stroke="#1a1a25" strokeWidth="3" />
                <circle cx="18" cy="18" r="14" fill="none" stroke="url(#dock-pgr)" strokeWidth="3"
                  strokeDasharray={`${profileCompletion} ${100 - profileCompletion}`} strokeLinecap="round" />
                <defs><linearGradient id="dock-pgr" x1="0" y1="0" x2="1" y2="1">
                  <stop offset="0%" stopColor="#00d4ff" /><stop offset="100%" stopColor="#00cc88" />
                </linearGradient></defs>
              </svg>
              <span className="absolute inset-0 flex items-center justify-center text-[6px] text-[#00d4ff] font-bold">{profileCompletion}</span>
            </div>
            <span className="dock-label">Profile</span>
          </button>
        </div>
      </div>

      {/* ═══════════════════════════════════════════════════════════
           MAIN CONTENT
         ═══════════════════════════════════════════════════════════ */}
      <div className="relative z-10 flex-1 flex flex-col min-h-0">

        {/* ── Ultra-minimal identity bar ── */}
        <div className="relative z-30 flex items-center justify-between px-5 py-2.5">
          <div className="flex items-center gap-2.5">
            <div className="w-6 h-6 rounded-lg bg-gradient-to-br from-[#00d4ff] to-[#00cc88] flex items-center justify-center shadow-lg shadow-[#00d4ff]/20">
              <svg viewBox="0 0 20 20" className="w-3 h-3" fill="white"><circle cx="10" cy="10" r="3.5" /></svg>
            </div>
            <div>
              <span className="text-white/60 font-semibold text-[11px] tracking-tight">CivicBridge</span>
              {activeAgents.length > 1 && (
                <div className="flex items-center gap-0.5 mt-0.5">
                  {activeAgents.map((a) => (
                    <span key={a} className="text-[8px]" title={AGENT_LABELS[a]?.label}>{AGENT_LABELS[a]?.icon}</span>
                  ))}
                </div>
              )}
            </div>
          </div>

          <div className="flex items-center gap-3">
            <span className="text-[10px] text-white/25 font-medium hidden sm:block">{currentAppName}</span>
            <button onClick={handleLogout}
              className="flex items-center gap-1.5 px-2 py-1 rounded-lg hover:bg-white/[0.03] transition-all group">
              <div className="w-5 h-5 rounded-full bg-gradient-to-br from-[#00d4ff]/30 to-[#00cc88]/20 flex items-center justify-center">
                <span className="text-[8px] text-[#00d4ff] font-bold">{(user?.name || 'U')[0].toUpperCase()}</span>
              </div>
              <span className="text-white/35 text-[10px] font-medium truncate max-w-[60px] hidden sm:block group-hover:text-white/60">{user?.name || 'User'}</span>
            </button>
          </div>
        </div>

        {/* ── Central experience area ── */}
        <div className="flex-1 flex flex-col items-center justify-center relative px-4 pb-16">

          {/* Phase progress chips */}
          <div className="absolute top-2 left-0 right-0 flex justify-center z-20">
            <div className="flex items-center gap-1 px-3 py-1.5 rounded-full bg-white/[0.02] border border-white/[0.03]">
              {phases.map((phase, i) => (
                <div key={i} className="flex items-center gap-1 group" title={phase.name}>
                  <span className="text-[9px]">{phase.icon}</span>
                  <div className={`w-6 h-[3px] rounded-full transition-all duration-500 ${
                    phase.done ? 'bg-gradient-to-r from-[#00d4ff] to-[#00cc88]' : 'bg-white/[0.06]'
                  }`} />
                  {i < phases.length - 1 && <div className="w-1 h-px bg-white/[0.04]" />}
                </div>
              ))}
            </div>
          </div>

          {/* THE GLOBE */}
          <div className={`transition-all duration-700 ease-out ${showChat && messages.length > 0 ? 'scale-[0.7] -translate-y-4 lg:scale-[0.85] lg:-translate-y-2' : ''}`}>
            <Globe
              status={status}
              inCall={inCall}
              volume={micVolume}
              onClick={handleGlobeClick}
              tapText={tapText}
            />
          </div>

          {/* Call controls */}
          <div className="mt-3 flex items-center justify-center gap-3 z-20">
            {inCall ? (
              <button onClick={handleEndCall}
                className="flex items-center gap-2 px-5 py-2 rounded-full bg-red-500/10 border border-red-500/15 text-red-400 text-[11px] font-medium hover:bg-red-500/20 transition-all active:scale-95">
                <svg className="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 9c-1.6 0-3.15.25-4.6.72v3.1c0 .39-.23.74-.56.9-.98.49-1.87 1.12-2.66 1.85-.18.18-.43.28-.7.28-.28 0-.53-.11-.71-.29L.29 13.08a.956.956 0 01-.29-.7c0-.28.11-.53.29-.71C3.34 8.78 7.46 7 12 7s8.66 1.78 11.71 4.67c.18.18.29.43.29.71 0 .28-.11.53-.29.71l-2.48 2.48c-.18.18-.43.29-.71.29-.27 0-.52-.11-.7-.28-.79-.74-1.69-1.36-2.67-1.85-.33-.16-.56-.5-.56-.9v-3.1C15.15 9.25 13.6 9 12 9z" />
                </svg>
                End
              </button>
            ) : (
              <button onClick={handleGlobeClick}
                className="flex items-center gap-2 px-5 py-2 rounded-full bg-[#00d4ff]/[0.08] border border-[#00d4ff]/10 text-[#00d4ff]/80 text-[11px] font-medium hover:bg-[#00d4ff]/15 hover:text-[#00d4ff] transition-all active:scale-95">
                <svg className="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 14c1.66 0 3-1.34 3-3V5c0-1.66-1.34-3-3-3S9 3.34 9 5v6c0 1.66 1.34 3 3 3z" />
                  <path d="M17 11c0 2.76-2.24 5-5 5s-5-2.24-5-5H5c0 3.53 2.61 6.43 6 6.92V21h2v-3.08c3.39-.49 6-3.39 6-6.92h-2z" />
                </svg>
                Voice
              </button>
            )}
            <button onClick={() => setShowChat(!showChat)}
              className={`flex items-center gap-2 px-4 py-2 rounded-full border text-[11px] font-medium transition-all active:scale-95 ${
                showChat ? 'bg-white/[0.06] border-white/[0.08] text-white/70' : 'bg-white/[0.02] border-white/[0.04] text-white/40 hover:text-white/60'
              }`}>
              <svg className="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" strokeWidth={1.5}>
                <path strokeLinecap="round" strokeLinejoin="round" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
              </svg>
              Chat
              {messages.length > 0 && (
                <span className="w-4 h-4 rounded-full bg-[#00d4ff]/20 text-[#00d4ff] text-[8px] font-bold flex items-center justify-center">
                  {messages.length}
                </span>
              )}
            </button>
          </div>

          {/* ── FLOATING CHAT OVERLAY ── */}
          <div className={`w-full max-w-2xl mt-3 transition-all duration-500 overflow-hidden ${
            showChat ? 'max-h-[40vh] lg:max-h-[35vh] opacity-100' : 'max-h-0 opacity-0'
          }`}>
            <div className="flex flex-col bg-[#0a0a12]/80 backdrop-blur-xl rounded-2xl border border-white/[0.03] shadow-2xl shadow-black/40 overflow-hidden">
              {/* Messages */}
              <div className="flex-1 overflow-y-auto p-3 space-y-2 scrollbar-thin max-h-[28vh] lg:max-h-[25vh]">
                {messages.length === 0 && (
                  <div className="flex items-center justify-center py-8">
                    <p className="text-white/20 text-[11px]">Start a voice call or type below</p>
                  </div>
                )}

                {messages.map((msg, i) => (
                  <div key={i} className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'} animate-fade-in-up`}>
                    {msg.role === 'system' ? (
                      <div className="w-full px-3 py-2 rounded-xl bg-[#00d4ff]/[0.04] border border-[#00d4ff]/[0.06]">
                        <p className="text-[10px] text-[#00d4ff]/60">{msg.content}</p>
                      </div>
                    ) : (
                      <div className={`max-w-[80%] rounded-2xl px-3 py-2 text-[11px] leading-relaxed ${
                        msg.role === 'user'
                          ? 'bg-white/[0.05] text-white/85 rounded-br-md'
                          : 'bg-[#00d4ff]/[0.04] text-white/75 border border-[#00d4ff]/[0.06] rounded-bl-md'
                      }`}>
                        {msg.role === 'assistant' && msg.agents && msg.agents.length > 1 && (
                          <div className="flex gap-0.5 mb-0.5">
                            {msg.agents.map((a) => (
                              <span key={a} className="text-[7px]" title={AGENT_LABELS[a]?.label}>{AGENT_LABELS[a]?.icon}</span>
                            ))}
                          </div>
                        )}
                        <p className="whitespace-pre-wrap">{msg.content}</p>
                      </div>
                    )}
                  </div>
                ))}
                <div ref={chatEndRef} />
              </div>

              {/* Text input */}
              <div className="border-t border-white/[0.03] p-2">
                <div className="flex items-center gap-2">
                  <input type="text" value={textInput} onChange={(e) => setTextInput(e.target.value)}
                    onKeyDown={handleKeyDown} placeholder="Type a message..."
                    className="flex-1 bg-white/[0.02] border border-white/[0.04] rounded-xl px-3.5 py-2 text-white text-[11px] placeholder-[#333] outline-none focus:border-[#00d4ff]/15 transition-colors" />
                  <button onClick={sendTextMessage} disabled={!textInput.trim()}
                    className="w-8 h-8 rounded-xl bg-gradient-to-r from-[#00d4ff] to-[#00cc88] flex items-center justify-center shrink-0 disabled:opacity-15 hover:opacity-90 transition-all active:scale-95">
                    <svg className="w-3 h-3 text-black" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M2.01 21L23 12 2.01 3 2 10l15 2-15 2z" />
                    </svg>
                  </button>
                </div>
              </div>
            </div>
          </div>

          {/* ── Floating Form Preview ── */}
          {formScreenshot && (
            <div className="fixed bottom-20 left-4 w-[260px] rounded-2xl bg-[#0a0a10]/95 border border-white/[0.05] overflow-hidden backdrop-blur-xl shadow-2xl shadow-black/50 animate-fade-in-up z-30">
              <div className="flex items-center gap-2 px-3 py-2 border-b border-white/[0.03] bg-white/[0.01]">
                <div className="flex gap-0.5">
                  <div className="w-1.5 h-1.5 rounded-full bg-[#ff5f56]/50" />
                  <div className="w-1.5 h-1.5 rounded-full bg-[#ffbd2e]/50" />
                  <div className="w-1.5 h-1.5 rounded-full bg-[#27c93f]/50" />
                </div>
                <span className="text-[7px] text-[#444] truncate flex-1">{formInfo?.page_name || 'gov.in'}</span>
                <div className="flex items-center gap-1">
                  <div className="w-1 h-1 rounded-full bg-[#00cc88] animate-pulse" />
                  <span className="text-[7px] text-[#00cc88] font-medium">Live</span>
                </div>
              </div>
              <div className="p-2">
                <img src={formScreenshot} alt="Live Form" className="rounded-lg w-full max-h-[140px] object-contain bg-white/[0.02]" />
                {formInfo?.fields_filled != null && (
                  <div className="mt-1.5 flex items-center justify-between px-1">
                    <span className="text-[8px] text-[#555]">{formInfo.fields_filled}/{formInfo.total_fields} fields</span>
                    <span className="text-[8px] text-[#00cc88] font-medium">📝 Form Agent</span>
                  </div>
                )}
              </div>
            </div>
          )}
        </div>
      </div>

      {/* ═══ SLIDE PANELS ═══ */}
      <LeftPanel isOpen={leftOpen} onClose={() => setLeftOpen(false)} />
      <RightPanel isOpen={rightOpen} onClose={() => setRightOpen(false)} />
      <ApplicationHistory
        isOpen={historyOpen}
        onClose={() => setHistoryOpen(false)}
        onSelectApplication={loadApplication}
        onNewApplication={startNewApplication}
        currentApplicationId={conversationId}
      />
    </div>
  );
}
